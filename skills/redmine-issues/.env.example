# Copy this file to .env in the same folder and fill in values.
# .env is ignored by .gitignore if you copy this skill into a repo.

REDMINE_BASE_URL=https://redmine.example.com
REDMINE_API_KEY=dummy_api_key_58469c776ab2b7d8e6125ba6dc

# Optional: default owner / assigned_to for new/updated issues
# Prefer login (readable); use ID to skip login→id lookup. If both are set, ID wins.
REDMINE_DEFAULT_ASSIGNED_TO_LOGIN=login_name
# REDMINE_DEFAULT_ASSIGNED_TO_ID=7
